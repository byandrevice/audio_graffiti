<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_voice_comment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#F1F2F6"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Threaded Reply Accent Bar (UCF Gold) -->
        <View
            android:id="@+id/thread_accent_bar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#FDC804"
            android:visibility="gone" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Replying To Banner (e.g. ↩ Replying to @SarahK) -->
            <LinearLayout
                android:id="@+id/reply_target_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/comment_reply_to_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↩ Replying to @SarahK"
                    android:textColor="#3B4870"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Avatar Photo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatar_card"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_below="@+id/reply_target_container"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="#FFE082"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/comment_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Comment Avatar"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#121212" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Author Name & Time -->
            <LinearLayout
                android:id="@+id/author_info_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/reply_target_container"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/avatar_card"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/comment_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex Knight"
                    android:textColor="#121212"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/comment_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="12m ago"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Play Voice Comment Button -->
            <Button
                android:id="@+id/btn_play_comment"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_below="@+id/reply_target_container"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toStartOf="@+id/actions_right_container"
                android:layout_toEndOf="@+id/author_info_container"
                android:paddingHorizontal="10dp"
                android:text="▶ 0:15"
                android:textColor="#121212"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="#FDC804"
                app:strokeWidth="1.5dp" />

            <!-- Right Actions: Direct Reply Link & Like Heart Button -->
            <LinearLayout
                android:id="@+id/actions_right_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/reply_target_container"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Reply Link Button -->
                <TextView
                    android:id="@+id/btn_reply_to_comment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:padding="4dp"
                    android:text="Reply"
                    android:textColor="#3B4870"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Like Comment Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_like_comment"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FFCDD2"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Like Comment"
                        android:padding="6dp"
                        android:src="@android:drawable/btn_star_big_on"
                        app:tint="#D32F2F" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>