<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/campus_background"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="16dp"
    tools:context=".CampusMapActivity">

    <!-- Left Column: Header Info & Action -->
    <LinearLayout
        android:id="@+id/campus_header"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- App Logo -->
                <ImageView
                    android:id="@+id/app_logo_imageView"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="App Logo"
                    android:src="@drawable/app_logo" />

                <TextView
                    android:id="@+id/campus_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/campus_brand"
                    android:textColor="@color/campus_foreground"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Settings Access Button (Yellow Circle Profile Icon) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_settings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="#FDC804"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Settings"
                    android:padding="7dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#121212" />
            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>

        <TextView
            android:id="@+id/campus_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="true"
            android:text="@string/campus_title"
            android:textColor="@color/campus_foreground"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/campus_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/campus_subtitle"
            android:textColor="@color/campus_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/campus_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="48dp"
            android:backgroundTint="@color/campus_primary"
            android:text="@string/campus_record"
            android:textColor="@color/campus_foreground"
            android:textStyle="bold"
            app:cornerRadius="@dimen/campus_control_radius"
            app:icon="@drawable/ic_campus_mic"
            app:iconGravity="textStart"
            app:iconTint="@color/campus_foreground" />

    </LinearLayout>

    <!-- Right Column: Campus Map Panel -->
    <com.scanner.audio_graffiti.ui.CampusMapPanel
        android:id="@+id/campus_map"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4" />

</LinearLayout>