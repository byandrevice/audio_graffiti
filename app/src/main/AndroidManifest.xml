<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".AudioGraffitiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioGraffiti"
        tools:targetApi="31">

        <!-- App Entry Launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Screens -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Main Campus Map Screen -->
        <activity
            android:name=".CampusMapActivity"
            android:exported="false" />

        <!-- Report User Screen -->
        <activity
            android:name=".ReportUserActivity"
            android:exported="false" />

        <!-- Main Settings Screen -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Settings Sub-Pages -->
        <activity
            android:name=".settings.SettingAccountActivity"
            android:exported="false" />
        <activity
            android:name=".settings.SettingPersonalizationActivity"
            android:exported="false" />
        <activity
            android:name=".settings.SettingLocationActivity"
            android:exported="false" />
        <activity
            android:name=".settings.SettingNotificationActivity"
            android:exported="false" />
        <activity
            android:name=".settings.SettingPrivacyActivity"
            android:exported="false" />
        <activity
            android:name=".settings.SettingHelpActivity"
            android:exported="false" />

    </application>

</manifest>