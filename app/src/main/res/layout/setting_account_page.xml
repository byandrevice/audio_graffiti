<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Circular Back Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/back_button_card"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#F0F0F3"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#121212" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:id="@+id/screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Account"
            android:textColor="#121212"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/back_button_card" />

        <!-- Centered Avatar Container -->
        <FrameLayout
            android:id="@+id/avatar_container"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/screen_title">

            <!-- Avatar Image with Yellow Ring -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="50dp"
                app:cardElevation="0dp"
                app:strokeColor="#FDC804"
                app:strokeWidth="3dp">

                <ImageView
                    android:id="@+id/avatar_imageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#121212" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Pencil Edit Badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/edit_avatar_badge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                app:cardBackgroundColor="#FDC804"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#121212" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Display Name -->
        <TextView
            android:id="@+id/username_textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="John Doe"
            android:textColor="#121212"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar_container" />

        <!-- User Email Subtitle -->
        <TextView
            android:id="@+id/email_textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="johndoe@ucf.edu"
            android:textColor="#757575"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/username_textView" />

        <!-- Input Fields Container -->
        <LinearLayout
            android:id="@+id/input_fields_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/email_textView">

            <!-- Name Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Name"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#FDC804"
                app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                app:startIconTint="#121212">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/userName_edit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="textPersonName"
                    android:text="John Doe"
                    android:textColor="#121212"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="#FDC804"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="#121212">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email_edit"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="textEmailAddress"
                    android:text="johndoe@ucf.edu"
                    android:textColor="#121212"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Delete Account Link -->
        <TextView
            android:id="@+id/deleteAccount_textLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawablePadding="6dp"
            android:text="Delete Account"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold"
            app:drawableStartCompat="@android:drawable/ic_delete"
            app:drawableTint="#D32F2F"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_fields_container" />

        <!-- Pill-Shaped Action Buttons Container -->
        <LinearLayout
            android:id="@+id/buttons_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deleteAccount_textLink"
            app:layout_constraintVertical_bias="1.0">

            <!-- 1. Update Button -->
            <Button
                android:id="@+id/update_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#F5F5F5"
                android:text="Update"
                android:textColor="#121212"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:icon="@android:drawable/checkbox_on_background"
                app:iconGravity="textStart"
                app:iconTint="#121212"
                app:strokeColor="#FDC804"
                app:strokeWidth="1.5dp" />

            <!-- 2. Edit Password Button -->
            <Button
                android:id="@+id/editPassword_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#FDC804"
                android:text="Edit Password"
                android:textColor="#121212"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="26dp" />

            <!-- 3. Log Out Button -->
            <Button
                android:id="@+id/logout_button_account"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FDC804"
                android:text="Log Out"
                android:textColor="#121212"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="26dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>