<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/campus_background"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView android:id="@+id/campus_sheet_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:textColor="@color/campus_foreground" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/campus_sheet_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/campus_muted" android:textSize="16sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/campus_sheet_close" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="24dp" android:text="@string/campus_close" android:textColor="@color/campus_foreground" android:backgroundTint="@color/campus_primary" app:cornerRadius="@dimen/campus_control_radius" />
</LinearLayout>
