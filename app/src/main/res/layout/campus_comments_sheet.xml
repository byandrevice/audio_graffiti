<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Header: Title, Author, and Reaction/Like Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btn_like_memo"
            android:orientation="vertical">

            <TextView
                android:id="@+id/memo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finals study spot at Student Union"
                android:textColor="#121212"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/memo_author_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="by John Doe • Student Union"
                android:textColor="#757575"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Reaction / Like Button (Heart + Likes Counter) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_like_memo"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#FFEBEE"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#FFCDD2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/heart_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Heart Reaction"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="#D32F2F" />

                <TextView
                    android:id="@+id/text_likes_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="24 Likes"
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <!-- Voice Comments Section Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Voice Responses &amp; Comments"
            android:textColor="#121212"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_comments_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="3 comments"
            android:textColor="#757575"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- Comments List (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/comments_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_voice_comment" />

    <!-- Record Voice Response Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_record_comment"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FDC804"
        android:text="RECORD VOICE RESPONSE"
        android:textColor="#121212"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_campus_mic"
        app:iconGravity="textStart"
        app:iconTint="#121212" />

</LinearLayout>