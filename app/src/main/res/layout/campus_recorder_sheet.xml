<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: RECORDING -->
    <TextView
        android:id="@+id/recorder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="RECORDING"
        android:textColor="#757575"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Timer & Waveform & Stop Button Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/recorder_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="0:24"
                android:textColor="#121212"
                android:textSize="32sp"
                android:textStyle="bold" />

            <com.scanner.audio_graffiti.ui.RecordingWaveformView
                android:id="@+id/recorder_waveform"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Live Microphone Waveform" />

        </LinearLayout>

        <!-- Circular Yellow Stop Recording Button with Black Square Icon -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/recorder_stop"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#FDC804"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Stop Recording"
                android:src="@android:drawable/checkbox_off_background"
                app:tint="#121212" />
        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

    <!-- Bottom Actions Row: Cancel Link & Max Duration Note -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/btn_cancel_recording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:text="Cancel"
            android:textColor="#121212"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_max_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Maximum 1:30"
            android:textColor="#757575"
            android:textSize="13sp" />

    </RelativeLayout>

    <!-- Hidden Playback Container for Saved Recording Review -->
    <LinearLayout
        android:id="@+id/playback_review_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/recorder_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#757575"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recorder_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="Play recording"
            android:textColor="#121212"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>